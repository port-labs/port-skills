{
  "identifier": "scaffold_microservice",
  "title": "Scaffold a microservice",
  "icon": "Microservice",
  "description": "Create a new microservice from the team's standard template and register it in the catalog.",
  "trigger": {
    "type": "self-service",
    "operation": "CREATE",
    "userInputs": {
      "properties": {
        "service_name": {
          "type": "string",
          "title": "Service name",
          "description": "Lowercase, hyphenated, e.g. billing-api."
        },
        "language": {
          "type": "string",
          "title": "Language",
          "enum": ["typescript", "python", "go"],
          "default": "typescript"
        },
        "repo_visibility": {
          "type": "string",
          "title": "Repository visibility",
          "enum": ["private", "internal"],
          "default": "private"
        }
      },
      "required": ["service_name", "language"]
    }
  },
  "invocationMethod": {
    "type": "WEBHOOK",
    "url": "https://example.com/hooks/scaffold-microservice",
    "agent": false,
    "synchronized": false,
    "method": "POST",
    "headers": {
      "RUN_ID": "{{ .run.id }}"
    },
    "body": {
      "service_name": "{{ .inputs.service_name }}",
      "language": "{{ .inputs.language }}",
      "repo_visibility": "{{ .inputs.repo_visibility }}",
      "requested_by": "{{ .trigger.user.email }}",
      "port_context": {
        "run_id": "{{ .run.id }}"
      }
    }
  },
  "requiredApproval": false
}
